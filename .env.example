MAXPLUS_API_KEY=ccsk-put-your-key-from-https://maxplus-ai.cc/dashboard-here
MAXPLUS_BASE_URL=https://api.maxplus-ai.cc/chinese-specials/v1
MAXPLUS_MODEL=glm-5.3-flash
EXA_API_KEY=put-your-key-from-https://dashboard.exa.ai/api-keys-here
# --- glow-up knobs (all optional, defaults = old behavior) ---
# FORMY_FALLBACK_MODELS=kimi-k2.6,deepseek-v4-flash-0731
# FORMY_BACKEND=local            # local|docker|ssh (read per call, no restart needed)
# FORMY_DOCKER_CONTAINER=mydev   # required for docker backend
# FORMY_SSH_TARGET=user@host     # required for ssh backend
# FORMY_APPROVAL=deny            # ask (CLI prompt) | deny (server default) | allow (sandbox only)
# FORMY_FILE_SCOPE=allow          # sandbox only: permit writes to ~/.ssh, /etc, /System, keychains (blocked by default)
# FORMY_TOKEN=long-random-value   # off by default; when set, every /api/* needs it (header or ?token=)
# FORMY_HOST=127.0.0.1            # loopback default; non-loopback bind without FORMY_TOKEN refuses to start
# MCP_TIMEOUT=30                  # seconds per MCP stdio call (per-server timeout in .mcp.json wins)
